// Clock and Reset
IO_LOC "clk" H11;
IO_PORT "clk" PULL_MODE=UP;

IO_LOC "rst" C7;
IO_PORT "rst" PULL_MODE=DOWN;  // Active-high reset, pull down to keep inactive

// RGB LED (WS2812B single wire)
IO_LOC "rgb_led" P9;
IO_PORT "rgb_led" PULL_MODE=NONE DRIVE=8;

// SPI from ESP32
IO_LOC "esp_miso" C11;
IO_PORT "esp_miso" PULL_MODE=NONE DRIVE=8;
IO_LOC "esp_sclk" A11;
IO_PORT "esp_sclk" PULL_MODE=NONE;
IO_LOC "esp_mosi" B11;
IO_PORT "esp_mosi" PULL_MODE=NONE;
IO_LOC "esp_cs_n" A12;
IO_PORT "esp_cs_n" PULL_MODE=UP;