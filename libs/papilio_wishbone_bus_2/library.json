  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "libArchive": false,
    "srcFilter": [
      "+<firmware/arduino/src/*>"
    ],
    "includeDir": "firmware/arduino/src"
  },
  "export": {
    "include": [
      "firmware/arduino/src/*",
      "hdl/*",
      "tools/*",
      "docs/*"
    ]
  }
