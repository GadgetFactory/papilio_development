  "guidelines": {
    "choosing_id": "Use two uppercase ASCII letters that are mnemonic for the device name",
    "encoding": "First character in MSB, second in LSB: ID = (char1 << 8) | char2",
    "reserved": "0x0000-0x00FF are reserved for future use",
    "custom": "Custom devices should use IDs starting from 0x8000"
  },
  "examples": [
    "RGB LED: 'LE' -> 0x4C45 (L=0x4C, E=0x45)",
    "SID Audio: 'SI' -> 0x5349 (S=0x53, I=0x49)",
    "Video: 'VI' -> 0x5649 (V=0x56, I=0x49)"
